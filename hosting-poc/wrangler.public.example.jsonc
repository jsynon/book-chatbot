{
  // Example configuration only; it is not the live account configuration.
  // Review account-specific bindings and secrets before using it. The public
  // and evaluation flags below stay disabled unless intentionally enabled.
  "name": "antilogicalism-companion-public",
  "main": "./hosting-poc/public-gateway.mjs",
  "compatibility_date": "2026-10-18",
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "vars": {
    "PUBLIC_ENABLED": "false",
    "PUBLIC_PILOT_ENABLED": "false",
    // Enable only when running the protected, manually dispatched evaluation.
    "PILOT_EVALUATION_ENABLED": "false"
  },
  // Namespaces must be unique within your own Cloudflare account; replace
  // these example namespace IDs with your own positive integer strings.
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "913701",
      "simple": { "limit": 2, "period": 60 }
    },
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "913702",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
